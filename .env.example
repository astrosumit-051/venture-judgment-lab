# Server-only OpenAI-compatible Conversational Teacher configuration.
# Production values belong in private Sites runtime secrets, never browser code.
LAB_AI_BASE_URL=https://api.openai.com/v1
LAB_AI_API_KEY=
LAB_AI_MODEL=gpt-5.6-luna

# Local-only runtime values. npm run dev and npm run local set the first two
# automatically; override the owner only if this Mac already has a different
# established local identity.
LAB_LOCAL_MODE=1
LAB_LOCAL_OWNER_ID=local-learner
LAB_LOCAL_DATA_PATH=.private/venture-judgment-lab/local-db

# Use a private random value of at least 32 characters for local operators.
LAB_AUTOMATION_TOKEN=

# For local development, LAB_AI_BASE_URL may point to an OpenAI-compatible
# laptop endpoint such as http://127.0.0.1:11434/v1.
